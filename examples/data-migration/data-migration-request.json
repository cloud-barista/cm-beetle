{
  "source": {
    "storageType": "objectstorage",
    "path": "kt-test-source-bucket/data/",
    "objectStorage": {
      "accessType": "minio",
      "minio": {
        "endpoint": "s3.ap-northeast-1.ktcloud.com",
        "accessKeyId": "YOUR_KT_S3_ACCESS_KEY",
        "secretAccessKey": "YOUR_KT_S3_SECRET_KEY",
        "region": "kr1",
        "useSSL": true
      }
    },
    "filter": {
      "include": [
        "*"
      ],
      "exclude": [
        "*.tmp",
        ".trash/*"
      ]
    }
  },
  "destination": {
    "storageType": "objectstorage",
    "path": "test-os-01/data/",
    "objectStorage": {
      "accessType": "tumblebug",
      "tumblebug": {
        "endpoint": "http://localhost:1323/tumblebug",
        "nsId": "mig01",
        "osId": "test-os-01",
        "expires": 3600,
        "auth": {
          "authType": "basic",
          "basic": {
            "username": "default",
            "password": "default"
          }
        }
      }
    }
  },
  "strategy": "auto"
}
