# Backend service endpoints used by Next.js API route handlers (server-side only).
# In local development these default to localhost ports.
# In Docker Compose these are overridden with internal DNS names (e.g. http://cm-honeybee:8081).
BEETLE_ENDPOINT=http://localhost:8056
TUMBLEBUG_ENDPOINT=http://localhost:1323
HONEYBEE_ENDPOINT=http://localhost:8081
SPIDER_ENDPOINT=http://localhost:1024
MAPUI_ENDPOINT=http://localhost:1324

# Basic Auth credentials injected by server-side Next.js proxy routes (never exposed to the browser).
# Copy this file to .env.local for local dev and fill in matching credentials for your backend stack.
BEETLE_API_USERNAME=
BEETLE_API_PASSWORD=
TUMBLEBUG_API_USERNAME=
TUMBLEBUG_API_PASSWORD=
SPIDER_API_USERNAME=
SPIDER_API_PASSWORD=
